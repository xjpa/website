---
import { getCollection } from 'astro:content';
import { site } from '../content/site';
import { Image } from 'astro:assets';
import portraitOne from '../assets/slide01.jpg';
import portraitTwo from '../assets/slide2.jpg';
import boomTown from '../assets/boomtown.jpeg';
import '../styles/window-theme.css';
import '../styles/interactive-home.css';

const projects = (await getCollection('projects')).sort((a, b) => a.data.title.localeCompare(b.data.title));
const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Open+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="John Amata's corner of the internet. Systems, software, side quests, and notes on moving forward." />
    <link rel="icon" type="image/png" href="/eagle.png" />
    <link rel="canonical" href={`${site.url}/`} />
    <title>{site.name}</title>
  </head>
  <body>
    <a class="skip-link" href="#index">Skip to index</a>
    <div class="desktop-frame">
      <header class="masthead">
        <a href="/" aria-current="page">john amata's personal website</a>
        <span>a work in progress, as always.</span><button class="restore-windows" hidden>Restore windows ↗</button>
      </header>
      <main id="index" class="index-grid">
        <div class="column">
          <section class="frame intro-frame">
            <button class="window-close" aria-label="Close this panel">×</button>
            <span class="panel-label">01 / hello, internet</span>
            <h1>John<br />Amata<span class="star">✳</span></h1>
            <p class="intro-line">Full stack engineer, from math to systems.</p>
            <p>I like building things, figuring out how they work, and seeing how far I can take them.</p>
            <p class="small-note">Welcome to my little corner of the web.</p>
          </section>
          <section class="frame photo-panel">
            <button class="window-close" aria-label="Close photo tiles">×</button>
            <span class="panel-label">a couple of snapshots</span>
            <div class="photo-tiles">
              <Image src={portraitOne} alt="Photo of John Amata" width={320} height={360} loading="lazy" />
              <Image src={portraitTwo} alt="Another snapshot of John Amata" width={320} height={360} loading="lazy" />
            </div>
          </section>
          <div class="frame ornament" aria-hidden="true">· ˚ ✳ · ˚ ✳ · ˚ ✳ · ˚ ✳ · ˚ ✳ ·</div>
          <section class="frame">
            <button class="window-close" aria-label="Close this panel">×</button>
            <span class="panel-label">02 / currently exploring</span>
            <p>I am into artificial intelligence and cloud infrastructure. I currently work as a software engineer, while also working through a <a href="/projects/masters/">master's degree</a></p>
          </section>
          <a class="frame envelope" href={`mailto:${site.email}`}>
            <svg viewBox="0 0 400 95" preserveAspectRatio="none" aria-hidden="true"><path d="M0 0 L200 95 L400 0" /></svg>
            <span>Questions? E-mail ↗</span>
          </a>
        </div>
        <div class="column">
          <section class="frame projects-frame">
            <button class="window-close" aria-label="Close this panel">×</button>
            <span class="panel-label">03 / things i'm working on</span>
            <h2>Skills.</h2>
            {projects.map(project => <p><a href={`/projects/${project.slug}/`}>{project.data.title}</a><br /><span>{project.data.summary}.</span></p>)}
            <a class="end-link" href="/archive/">The archive →</a>
          </section>
          <section class="frame project-image-panel" aria-labelledby="boomtown-title">
            <button class="window-close" aria-label="Close Boom Town tile">×</button>
            <div class="project-image-link">
              <Image src={boomTown} alt="Boom Town project preview" widths={[400, 800]} sizes="(max-width: 600px) 85vw, (max-width: 1000px) 42vw, 30vw" loading="lazy" />
              <span class="tile-caption"><strong id="boomtown-title">BOOMTOWN</strong></span>
              <p class="tile-description">Building a business simulation game inspired by my experience working at a construction company</p>
            </div>
          </section>
          <nav class="frame link-strip" aria-label="Primary navigation">
            <a href="/blog/">blog</a><a href="/archive/">archive</a><a href="/ascend/">ascend</a><a href={site.github}>github</a>
          </nav>
          <section class="frame">
            <button class="window-close" aria-label="Close this panel">×</button>
            <span class="panel-label">04 / notes from the field</span>
            <h2>Recent blog posts.</h2>
            {posts.slice(0, 3).map(post => <p><a href={`/blog/${post.slug}/`}>{post.data.title} →</a><br /><span>{post.data.summary}</span></p>)}
            <a class="end-link" href="/blog/">All writing →</a>
          </section>
        </div>
        <div class="column">
          <section class="frame interests-frame">
            <button class="window-close" aria-label="Close this panel">×</button>
            <span class="panel-label">05 / my few recurring interests</span>
            <h2>Exploring<br />the dots</h2>
            <ul class="interest-list"><li>Systems engineering</li><li>Artificial Intelligence</li><li>Business & startups</li><li>Discipline & performance</li><li>Martial arts</li></ul>
            <div class="dot-field" aria-hidden="true">{Array.from({length: 60}, (_, i) => <span class:list={{ filled: (i * 7) % 11 < 5 }}>·</span>)}</div>
          </section>
          <section class="frame">
            <button class="window-close" aria-label="Close this panel">×</button>
            <span class="panel-label">06 / worth a visit</span>
            <h2>Internet links I like.</h2>
            <ul class="entry-list">
              <li><a href="https://felixrieseberg.com/how-to-be-more-ambitious-a-tutorial-for-humans-with-models/">How to be more ambitious ↗</a></li>
              <li><a href="https://www.nathalielawhead.com/candybox/ui-design-is-fun">UI design is fun ↗</a></li>
              <li><a href="https://sive.rs/4">Cross the world four times ↗</a></li>
              <li><a href="https://www.mathacademy.com/">Math Academy ↗</a></li>
            </ul>
          </section>
        </div>
      </main>
      <footer><span>Made of small experiments.</span><a href="#index">Back to the top ↑</a></footer>
    </div>

    <script>
      const restore = document.querySelector<HTMLButtonElement>('.restore-windows');
      document.querySelectorAll<HTMLButtonElement>('.window-close').forEach(button => {
        button.addEventListener('click', () => {
          const panel = button.closest<HTMLElement>('.frame');
          if (panel) panel.hidden = true;
          if (restore) { restore.hidden = false; restore.focus(); }
        });
      });
      restore?.addEventListener('click', () => {
        document.querySelectorAll<HTMLElement>('.frame[hidden]').forEach(panel => panel.hidden = false);
        restore.hidden = true;
        document.querySelector<HTMLButtonElement>('.window-close')?.focus();
      });
    </script>
  </body>
</html>
