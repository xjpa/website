---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatDate, sortByDateDesc } from '../../lib/content';

const entries = sortByDateDesc(await getCollection('ascend'));
---

<BaseLayout
  title="Ascend | John Amata"
  description="Protocols, experiments, and notes on high-agency living and performance."
  canonicalPath="/ascend"
>
  <section class="blog-layout">
    <div class="section-heading">
      <p class="eyebrow">Ascend</p>
      <h1>we must ascend</h1>
      <p class="about-copy">your mind matches the depth of your life</p>
    </div>

    <div class="posts-grid">
      {
        entries.map((entry) => (
          <article class="post-card">
            <p class="post-date">{formatDate(entry.data.date)}</p>
            <h2>
              <a href={`/ascend/${entry.slug}/`}>{entry.data.title}</a>
            </h2>
            <p>{entry.data.summary}</p>
            <div class="tag-row">
              {entry.data.tags.map((tag: string) => <span class="tag">{tag}</span>)}
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
