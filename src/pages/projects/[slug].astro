---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { buildToc } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.slug } }));
}

const projects = await getCollection('projects');
const { slug } = Astro.params;
const project = projects.find((item) => item.slug === slug);

if (!project) {
  throw new Error(`Project not found for slug: ${slug}`);
}

const { Content, headings } = await project.render();
const toc = buildToc(headings);
---

<BaseLayout
  title={`${project.data.title} | John Amata`}
  description={project.data.summary}
  canonicalPath={`/projects/${project.slug}`}
>
  <article class="post-layout">
    <a class="inline-link" href="/">← Back to home</a>
    <p class="post-date">Project</p>
    <h1>{project.data.title}</h1>
    <p class="about-copy">{project.data.summary}</p>
    {
      headings.length > 1 ? (
        <nav class="table-of-contents" aria-label="Table of contents">
          <p class="toc-title">Contents</p>
          <TableOfContents headings={toc} />
        </nav>
      ) : null
    }
    <div class="post-body post-body-html">
      <Content />
    </div>
    {
      project.data.links.length > 0 ? (
        <div class="tag-row">
          {project.data.links.map((link: { label: string; href: string }) => <a class="tag project-tag-link" href={link.href} rel="noreferrer" target="_blank">{link.label}</a>)}
        </div>
      ) : null
    }
  </article>
</BaseLayout>
